{
  "name": "kubevirt-mock-apiserver",
  "version": "1.0.0",
  "description": "Mock Kubernetes + Prometheus API server for load-testing the kubevirt-plugin UI without a real cluster",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "ts-node src/index.ts",
    "start:ui": "ts-node src/index.ts --ui",
    "build": "tsc",
    "start:compiled": "node dist/index.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "selfsigned": "^2.4.1",
    "ws": "^8.20.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "@types/yargs": "^17.0.33",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  }
}
